# MG Helper package - transient files only.
# NOTE: .gitattributes from upstream is kept: *.ps1/*.bat/*.cs are CRLF, *.yml is LF.
# The installer deploys package files byte-for-byte, so do not change line endings.

# reports/logs are written into the live folder (%LOCALAPPDATA%\MG_Helper), never here
report_*.txt
*.log

# leftover of an interrupted atomic write
*.mgtmp

# OS / editor noise
Thumbs.db
desktop.ini
*.swp
*~
# Telegram bot token must never be committed (env MG_TG_TOKEN or DataRoot\telegram.json)
telegram.json

# WebView2 SDK скачивается tools\fetch-webview2.ps1 (бинарники в git не храним)
ui/lib/
